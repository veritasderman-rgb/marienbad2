---
import '../styles/global.css'
import type { Locale } from '../i18n/config'
import { t } from '../i18n/ui'
import ChatWidget from '../components/ChatWidget.tsx'

interface Props {
  title: string
  description?: string
  locale: Locale
  canonicalUrl?: string
  ogImage?: string
  schema?: object
}

const { title, description, locale, canonicalUrl, ogImage, schema } = Astro.props
const siteUrl = 'https://marienbad2.vercel.app'
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`
const og = ogImage ?? `${siteUrl}/images/og-default.jpg`

const locales: Locale[] = ['de', 'en', 'cs', 'ru']
const pathWithoutLocale = Astro.url.pathname.replace(/^\/[a-z]{2}\//, '/')
const hreflangs = locales.map((l) => ({
  lang: l,
  href: `${siteUrl}/${l}${pathWithoutLocale}`,
}))

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: 'Mariánské Lázně (Marienbad)',
  description: 'Historic Czech spa town famous for its healing mineral springs, colonnades and belle époque architecture.',
  url: siteUrl,
  touristType: ['Spa visitors', 'Wellness tourists', 'Culture tourists'],
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 49.9645986,
    longitude: 12.7012619,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mariánské Lázně',
    addressCountry: 'CZ',
  },
}
const finalSchema = schema ?? baseSchema
---
<!doctype html>
<html lang={locale} dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />

  {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}/de${pathWithoutLocale}`} />

  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content={og} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={locale} />

  <link rel="preload" href="/fonts/Branding-Medium.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/Branding-Bold.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/Branding-Semilight.otf" as="font" type="font/otf" crossorigin />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  {plausibleDomain && <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}

  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)}></script>
</head>
<body>
  <a href="#main" style="position:absolute;left:-9999px;top:0;background:#004F71;color:#fff;padding:12px 20px;z-index:9999;" onfocus="this.style.left='0'" onblur="this.style.left='-9999px'">
    {t(locale, 'common.backTo')}
  </a>
  <slot />
  <ChatWidget
    client:idle
    locale={locale}
    translations={{
      title: t(locale, 'chat.title'),
      placeholder: t(locale, 'chat.placeholder'),
      greeting: t(locale, 'chat.greeting'),
      disclaimer: t(locale, 'chat.disclaimer'),
    }}
  />
</body>
</html>
