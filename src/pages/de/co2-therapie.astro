---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'de-co2-therapie')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="de" title="CO₂-Therapie" eyebrow="Heilquellen & Kuren" coverTone="mineral" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Start',href:'/de/'},{label:'Heilquellen',href:'/de/mineralquellen'},{label:'CO₂-Therapie'}]}>
  {Content ? <Content /> : <p>Inhalt folgt. Diese Seite wird mit Ensana-Inhalten befüllt.</p>}
</PillarPage>
