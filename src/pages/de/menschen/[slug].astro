---
import { getCollection } from 'astro:content'
import type { Locale } from '../../../i18n/config'
import Base from '../../../layouts/Base.astro'
import Nav from '../../../components/Nav.astro'
import Footer from '../../../components/Footer.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import BookingCtaBar from '../../../components/BookingCtaBar.astro'
import Placeholder from '../../../components/Placeholder.astro'

export async function getStaticPaths() {
  const stories = await getCollection('stories', (e) => e.data.locale === 'de')
  return stories.map((entry) => ({ params: { slug: entry.slug.replace(/^de-/, '') }, props: { entry } }))
}

const { entry } = Astro.props
const locale: Locale = 'de'
const { Content } = await entry.render()
const crumbs = [
  { label: 'Startseite', href: '/de/' },
  { label: 'Menschen', href: '/de/menschen' },
  { label: entry.data.personName ?? entry.data.title },
]
---
<Base title={entry.data.title} locale={locale}>
  <Nav locale={locale} />
  <Breadcrumbs crumbs={crumbs} />

  <div style="background:#FAF6EE;padding:64px 80px 96px;max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 320px;gap:64px;align-items:start;">
    <article>
      {entry.data.quote && (
        <blockquote style="border-left:4px solid #8BD3E6;padding-left:24px;margin:0 0 40px;font-size:22px;color:#004F71;font-weight:350;font-style:italic;line-height:1.5;">
          &ldquo;{entry.data.quote}&rdquo;
        </blockquote>
      )}
      <h1 style="font-size:clamp(28px,4vw,48px);font-weight:700;color:#004F71;line-height:1.1;margin:0 0 8px;">
        {entry.data.personName ?? entry.data.title}
      </h1>
      {entry.data.location && (
        <p style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;color:#6695AA;font-weight:600;margin:0 0 32px;">
          {entry.data.location}
        </p>
      )}
      <div class="prose-marienbad">
        <Content />
      </div>
    </article>
    <aside style="position:sticky;top:100px;">
      <Placeholder tone="warm" style="height:360px;border-radius:8px;overflow:hidden;" />
      {entry.data.visitLabel && (
        <p style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#6695AA;font-weight:600;margin:16px 0 0;text-align:center;">
          {entry.data.visitLabel}
        </p>
      )}
    </aside>
  </div>

  <BookingCtaBar locale={locale} />
  <Footer locale={locale} />
</Base>
