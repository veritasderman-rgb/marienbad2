---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'de-aktivitaeten')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="de" title="Aktivitäten" eyebrow="Was zu tun" coverTone="forest"
  breadcrumbs={[{label:'Start',href:'/de/'},{label:'Aktivitäten',href:'/de/aktivitaeten'},{label:'Aktivitäten'}]}>
  {Content ? <Content /> : <p>Inhalt folgt. Diese Seite wird mit Ensana-Inhalten befüllt.</p>}
</PillarPage>
