---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'de-beruehmte-gaeste')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="de" title="Berühmte Gäste" eyebrow="Die Stadt" coverTone="warm" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Start',href:'/de/'},{label:'Geschichte',href:'/de/geschichte'},{label:'Berühmte Gäste'}]}>
  {Content ? <Content /> : <p>Inhalt folgt. Diese Seite wird mit Ensana-Inhalten befüllt.</p>}
</PillarPage>
