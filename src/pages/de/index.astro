---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Hero from '../../components/Hero.astro'
import QuickFacts from '../../components/QuickFacts.astro'
import FourSources from '../../components/FourSources.astro'
import Hotels from '../../components/Hotels.astro'
import Treatments from '../../components/Treatments.astro'
import Seasonal from '../../components/Seasonal.astro'
import Stories from '../../components/Stories.astro'
import BookingCta from '../../components/BookingCta.astro'
import GoogleReviews from '../../components/GoogleReviews.tsx'
import Footer from '../../components/Footer.astro'
import Newsletter from '../../components/Newsletter.astro'
import { t } from '../../i18n/ui'
import homepageContent from '../../content/homepage/de.json'

const locale = 'de'
---
<Base
  title={t(locale, 'meta.home.title')}
  description={t(locale, 'meta.home.desc')}
  locale={locale}
>
  <Nav locale={locale} currentPath="/de/" />
  <main id="main">
    <Hero locale={locale} variant="fullbleed" accentColour="turquoise" content={homepageContent.hero} />
    <QuickFacts locale={locale} />
    <FourSources locale={locale} accentColour="turquoise" />
    <Hotels locale={locale} accentColour="turquoise" />
    <Treatments locale={locale} accentColour="turquoise" />
    <Seasonal locale={locale} accentColour="turquoise" content={homepageContent.seasonal} />
    <Stories locale={locale} accentColour="turquoise" />
    <section style="background:#FAF6EE;padding:80px 80px 0;">
      <GoogleReviews client:visible locale={locale} translations={{ title: t(locale, 'reviews.title'), moreOnGoogle: t(locale, 'reviews.moreOnGoogle') }} />
    </section>
    <BookingCta locale={locale} accentColour="turquoise" content={homepageContent.bookingCta} />
    <Newsletter locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
