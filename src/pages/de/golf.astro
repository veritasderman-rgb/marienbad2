---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'de-golf')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="de" title="Golf" eyebrow="Was zu tun" coverTone="warm" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Start',href:'/de/'},{label:'Aktivitäten',href:'/de/aktivitaeten'},{label:'Golf'}]}>
  {Content ? <Content /> : <p>Inhalt folgt. Diese Seite wird mit Ensana-Inhalten befüllt.</p>}
</PillarPage>
