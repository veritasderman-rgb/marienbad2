---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'de-peloidtherapie')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="de" title="Peloidtherapie" eyebrow="Heilquellen & Kuren" coverTone="mineral"
  breadcrumbs={[{label:'Start',href:'/de/'},{label:'Heilquellen',href:'/de/mineralquellen'},{label:'Peloidtherapie'}]}>
  {Content ? <Content /> : <p>Inhalt folgt. Diese Seite wird mit Ensana-Inhalten befüllt.</p>}
</PillarPage>
