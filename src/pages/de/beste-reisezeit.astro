---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'de-beste-reisezeit')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="de" title="Beste Reisezeit" eyebrow="Praktisches" coverTone="forest"
  breadcrumbs={[{label:'Start',href:'/de/'},{label:'Praktisches',href:'/de/praktische-infos'},{label:'Beste Reisezeit'}]}>
  {Content ? <Content /> : <p>Inhalt folgt. Diese Seite wird mit Ensana-Inhalten befüllt.</p>}
</PillarPage>
