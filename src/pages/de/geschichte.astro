---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'de-geschichte')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="de" title="Geschichte" eyebrow="Die Stadt" coverTone="colonnade" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Start',href:'/de/'},{label:'Geschichte',href:'/de/geschichte'},{label:'Geschichte'}]}>
  {Content ? <Content /> : <p>Inhalt folgt. Diese Seite wird mit Ensana-Inhalten befüllt.</p>}
</PillarPage>
