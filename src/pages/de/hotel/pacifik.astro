---
import { hotels } from '../../../data/hotels'
import HotelDetail from '../../../components/HotelDetail.astro'

const locale = 'de' as const
const hotel = hotels.find((h) => h.slug === 'pacifik')
if (!hotel) throw new Error('Hotel not found: pacifik')

const breadcrumbs = [
  { label: 'Start', href: '/de/' },
  { label: 'Hotels', href: '/de/unterkunft' },
  { label: hotel.name },
]
---
<HotelDetail locale={locale} hotel={hotel} breadcrumbs={breadcrumbs} />
