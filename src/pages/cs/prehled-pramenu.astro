---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'cs-prehled-pramenu')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="cs" title="Přehled pramenů" eyebrow="Léčivé prameny" coverTone="water" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Úvod',href:'/cs/'},{label:'Prameny',href:'/cs/mineralni-prameny'},{label:'Přehled pramenů'}]}>
  {Content ? <Content /> : <p>Obsah bude doplněn. Tato stránka bude naplněna obsahem Ensana.</p>}
</PillarPage>
