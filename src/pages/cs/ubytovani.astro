---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'cs-ubytovani')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="cs" title="Ubytování" eyebrow="Kde přespat" coverTone="colonnade" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Úvod',href:'/cs/'},{label:'Hotely',href:'/cs/ubytovani'},{label:'Ubytování'}]}>
  {Content ? <Content /> : <p>Obsah bude doplněn. Tato stránka bude naplněna obsahem Ensana.</p>}
</PillarPage>
