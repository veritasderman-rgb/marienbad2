---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'cs-peloidni-terapie')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="cs" title="Peloidní terapie" eyebrow="Léčivé prameny" coverTone="mineral"
  breadcrumbs={[{label:'Úvod',href:'/cs/'},{label:'Prameny',href:'/cs/mineralni-prameny'},{label:'Peloidní terapie'}]}>
  {Content ? <Content /> : <p>Obsah bude doplněn. Tato stránka bude naplněna obsahem Ensana.</p>}
</PillarPage>
