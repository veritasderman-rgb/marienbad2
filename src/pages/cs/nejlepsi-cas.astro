---
import { getEntry } from 'astro:content'
import PillarPage from '../../components/PillarPage.astro'
const entry = await getEntry('pages', 'cs-nejlepsi-cas-navstevy')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="cs" title="Nejlepší čas navštívit" eyebrow="Praktické" coverTone="forest"
  breadcrumbs={[{label:'Úvod',href:'/cs/'},{label:'Praktické',href:'/cs/prakticke-informace'},{label:'Nejlepší čas navštívit'}]}>
  {Content ? <Content /> : <p>Obsah bude doplněn. Tato stránka bude naplněna obsahem Ensana.</p>}
</PillarPage>
