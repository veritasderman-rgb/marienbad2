---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'cs-architektura')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="cs" title="Architektura" eyebrow="Aktivity" coverTone="colonnade" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Úvod',href:'/cs/'},{label:'Aktivity',href:'/cs/co-delat'},{label:'Architektura'}]}>
  {Content ? <Content /> : <p>Obsah bude doplněn. Tato stránka bude naplněna obsahem Ensana.</p>}
</PillarPage>
