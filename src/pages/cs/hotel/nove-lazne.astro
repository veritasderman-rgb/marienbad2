---
import { hotels } from '../../../data/hotels'
import HotelDetail from '../../../components/HotelDetail.astro'

const locale = 'cs' as const
const hotel = hotels.find((h) => h.slug === 'nove-lazne')
if (!hotel) throw new Error('Hotel not found: nove-lazne')

const breadcrumbs = [
  { label: 'Úvod', href: '/cs/' },
  { label: 'Ubytování', href: '/cs/ubytovani' },
  { label: hotel.name },
]
---
<HotelDetail locale={locale} hotel={hotel} breadcrumbs={breadcrumbs} />
