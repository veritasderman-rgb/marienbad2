---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'cs-faq')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="cs" title="Časté otázky" eyebrow="Nejčastější dotazy" coverTone="warm"
  breadcrumbs={[{label:'Úvod',href:'/cs/'},{label:'Praktické',href:'/cs/prakticke-informace'},{label:'Časté otázky'}]}>
  {Content ? <Content /> : <p>Obsah bude doplněn. Tato stránka bude naplněna obsahem Ensana.</p>}
</PillarPage>
