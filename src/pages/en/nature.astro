---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'en-nature')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="en" title="Nature" eyebrow="What to do" coverTone="forest"
  breadcrumbs={[{label:'Home',href:'/en/'},{label:'Activities',href:'/en/things-to-do'},{label:'Nature'}]}>
  {Content ? <Content /> : <p>Content to follow. This page will be populated with Ensana content.</p>}
</PillarPage>
