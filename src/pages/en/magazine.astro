---
import { getCollection } from 'astro:content'
import type { Locale } from '../../i18n/config'
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import BookingCtaBar from '../../components/BookingCtaBar.astro'
import MagazineFilter from '../../components/MagazineFilter.tsx'

const locale: Locale = 'en'
const entries = await getCollection('articles', (e) => e.data.locale === 'en' && e.data.status === 'published')
entries.sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))

const articles = entries.map((e) => ({
  slug: e.slug.replace(/^en-/, ''),
  title: e.data.title,
  category: e.data.category ?? '',
  excerpt: e.data.excerpt ?? '',
  coverImage: e.data.coverImage,
  readingTime: typeof e.data.readingTime === 'number' ? `${e.data.readingTime} min` : (e.data.readingTime ?? ''),
  date: e.data.date ?? '',
}))
---
<Base title="Magazine – Marienbad" description="Travel stories, spa features and inspiration for your stay in Marienbad." locale={locale}>
  <Nav locale={locale} />

  <header style="background:#004F71;color:#fff;padding:80px 80px 64px;">
    <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#8BD3E6;font-weight:700;margin-bottom:16px;">Magazine</div>
    <h1 style="font-size:clamp(32px,5vw,64px);font-weight:700;line-height:1.05;letter-spacing:-0.01em;margin:0 0 16px;">Stories from Marienbad</h1>
    <p style="font-size:18px;color:rgba(255,255,255,0.8);font-weight:350;max-width:560px;margin:0;">Travel reports, spa stories and inspiration for your stay.</p>
  </header>

  <section style="background:#FAF6EE;padding:64px 80px 96px;">
    <MagazineFilter
      client:load
      articles={articles}
      locale={locale}
      magazineSlug="magazine"
      translations={{ all: 'All', readMore: 'Read more', featured: 'Featured' }}
    />
  </section>

  <BookingCtaBar locale={locale} />
  <Footer locale={locale} />
</Base>
