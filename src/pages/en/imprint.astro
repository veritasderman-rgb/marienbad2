---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'en-imprint')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="en" title="Imprint" eyebrow="Legal" coverTone="warm"
  breadcrumbs={[{label:'Home',href:'/en/'},{label:'Home',href:'/en/'},{label:'Imprint'}]}>
  {Content ? <Content /> : <p>Content to follow. This page will be populated with Ensana content.</p>}
</PillarPage>
