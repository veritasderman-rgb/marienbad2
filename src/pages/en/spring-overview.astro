---
import { getEntry } from 'astro:content'
import PillarPage from '../../components/PillarPage.astro'
const entry = await getEntry('pages', 'en-springs-overview')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="en" title="Spring Overview" eyebrow="Healing springs & spas" coverTone="water"
  breadcrumbs={[{label:'Home',href:'/en/'},{label:'Springs',href:'/en/mineral-springs'},{label:'Spring Overview'}]}>
  {Content ? <Content /> : <p>Content to follow. This page will be populated with Ensana content.</p>}
</PillarPage>
