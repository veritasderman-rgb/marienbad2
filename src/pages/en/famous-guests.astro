---
import { getEntry } from 'astro:content'
import PillarPage from '../../components/PillarPage.astro'
const entry = await getEntry('pages', 'en-famous-visitors')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="en" title="Famous Guests" eyebrow="About the town" coverTone="warm"
  breadcrumbs={[{label:'Home',href:'/en/'},{label:'History',href:'/en/history'},{label:'Famous Guests'}]}>
  {Content ? <Content /> : <p>Content to follow. This page will be populated with Ensana content.</p>}
</PillarPage>
