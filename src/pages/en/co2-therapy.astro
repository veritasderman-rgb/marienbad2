---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'en-co2-therapy')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="en" title="CO₂ Therapy" eyebrow="Healing springs & spas" coverTone="mineral" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Home',href:'/en/'},{label:'Springs',href:'/en/mineral-springs'},{label:'CO₂ Therapy'}]}>
  {Content ? <Content /> : <p>Content to follow. This page will be populated with Ensana content.</p>}
</PillarPage>
