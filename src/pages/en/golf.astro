---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'en-golf')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="en" title="Golf" eyebrow="What to do" coverTone="warm" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Home',href:'/en/'},{label:'Activities',href:'/en/things-to-do'},{label:'Golf'}]}>
  {Content ? <Content /> : <p>Content to follow. This page will be populated with Ensana content.</p>}
</PillarPage>
