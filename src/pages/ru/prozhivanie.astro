---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'ru-prozhivanie')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="ru" title="Проживание" eyebrow="Где остановиться" coverTone="colonnade" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Главная',href:'/ru/'},{label:'Отели',href:'/ru/prozhivanie'},{label:'Проживание'}]}>
  {Content ? <Content /> : <p>Содержание будет добавлено. Эта страница будет наполнена контентом Ensana.</p>}
</PillarPage>
