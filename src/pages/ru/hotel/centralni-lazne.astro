---
import { hotels } from '../../../data/hotels'
import HotelDetail from '../../../components/HotelDetail.astro'

const locale = 'ru' as const
const hotel = hotels.find((h) => h.slug === 'centralni-lazne')
if (!hotel) throw new Error('Hotel not found: centralni-lazne')

const breadcrumbs = [
  { label: 'Главная', href: '/ru/' },
  { label: 'Проживание', href: '/ru/prozhivanie' },
  { label: hotel.name },
]
---
<HotelDetail locale={locale} hotel={hotel} breadcrumbs={breadcrumbs} />
