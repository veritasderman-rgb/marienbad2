---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'ru-politika-konfidencialnosti')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="ru" title="Политика конфиденциальности" eyebrow="Правовое" coverTone="warm" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Главная',href:'/ru/'},{label:'Главная',href:'/ru/'},{label:'Политика конфиденциальности'}]}>
  {Content ? <Content /> : <p>Содержание будет добавлено. Эта страница будет наполнена контентом Ensana.</p>}
</PillarPage>
