---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'ru-istoriya')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="ru" title="История" eyebrow="О городе" coverTone="colonnade" coverImage={entry?.data.featuredImage}
  breadcrumbs={[{label:'Главная',href:'/ru/'},{label:'История',href:'/ru/istoriya'},{label:'История'}]}>
  {Content ? <Content /> : <p>Содержание будет добавлено. Эта страница будет наполнена контентом Ensana.</p>}
</PillarPage>
