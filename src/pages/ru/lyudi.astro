---
import { getCollection } from 'astro:content'
import type { Locale } from '../../i18n/config'
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import BookingCtaBar from '../../components/BookingCtaBar.astro'
import StoryFilter from '../../components/StoryFilter.tsx'
import StorySubmissionForm from '../../components/StorySubmissionForm.tsx'
import { t } from '../../i18n/ui'

const locale: Locale = 'ru'
const entries = await getCollection('stories', (e) => e.data.status === 'published')

const stories = entries.map((e) => ({
  slug: e.slug.replace(/^[a-z]{2}-/, ''),
  name: e.data.name ?? e.data.personName ?? e.data.title ?? '',
  location: e.data.location ?? '',
  visitLabel: e.data.visitLabel ?? '',
  quote: e.data.quote ?? '',
  lang: e.data.lang ?? e.data.locale,
  locale: e.data.locale,
  portrait: e.data.portrait,
}))
---
<Base title="Люди – Marienbad" description="Гости делятся своими впечатлениями о Марианских Лазнях и отелях Ensana." locale={locale}>
  <Nav locale={locale} />

  <header style="background:#0F3B52;color:#fff;padding:80px 80px 64px;">
    <div style="font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:#8BD3E6;font-weight:700;margin-bottom:16px;">Люди</div>
    <h1 style="font-size:clamp(32px,5vw,64px);font-weight:700;line-height:1.05;letter-spacing:-0.01em;margin:0 0 16px;">Их истории</h1>
    <p style="font-size:18px;color:rgba(255,255,255,0.75);font-weight:350;max-width:520px;margin:0;">Гости со всего мира рассказывают о своём пребывании в Марианских Лазнях.</p>
  </header>

  <section style="background:#FAF6EE;padding:64px 80px 96px;">
    <StoryFilter
      client:load
      stories={stories}
      currentLocale={locale}
      translations={{
        all: t(locale, 'filter.all'),
        byLanguage: t(locale, 'filter.byLanguage'),
        byLocation: t(locale, 'filter.byLocation'),
        noResults: t(locale, 'filter.noResults'),
      }}
    />
  </section>

  <section style="background:#fff;padding:64px 80px 96px;border-top:1px solid #E8DFCB;">
    <div style="max-width:720px;margin:0 auto;">
      <StorySubmissionForm
        client:visible
        locale={locale}
        translations={{
          formTitle: t(locale, 'storyForm.title'),
          formSubtitle: t(locale, 'storyForm.subtitle'),
          nameLabel: t(locale, 'storyForm.nameLabel'),
          namePlaceholder: t(locale, 'storyForm.namePlaceholder'),
          emailLabel: t(locale, 'storyForm.emailLabel'),
          emailPlaceholder: t(locale, 'storyForm.emailPlaceholder'),
          emailHint: t(locale, 'storyForm.emailHint'),
          locationLabel: t(locale, 'storyForm.locationLabel'),
          locationPlaceholder: t(locale, 'storyForm.locationPlaceholder'),
          visitLabel: t(locale, 'storyForm.visitLabel'),
          visitRecently: t(locale, 'storyForm.visitRecently'),
          visit1to5: t(locale, 'storyForm.visit1to5'),
          visit5to10: t(locale, 'storyForm.visit5to10'),
          visit10plus: t(locale, 'storyForm.visit10plus'),
          storyLabel: t(locale, 'storyForm.storyLabel'),
          storyPlaceholder: t(locale, 'storyForm.storyPlaceholder'),
          storyHint: t(locale, 'storyForm.storyHint'),
          photoConsent: t(locale, 'storyForm.photoConsent'),
          privacyConsent: t(locale, 'storyForm.privacyConsent'),
          submitButton: t(locale, 'storyForm.submitButton'),
          submitting: t(locale, 'storyForm.submitting'),
          successTitle: t(locale, 'storyForm.successTitle'),
          successMessage: t(locale, 'storyForm.successMessage'),
          errorMessage: t(locale, 'storyForm.errorMessage'),
          required: t(locale, 'storyForm.required'),
          minChars: t(locale, 'storyForm.minChars'),
        }}
      />
    </div>
  </section>

  <BookingCtaBar locale={locale} />
  <Footer locale={locale} />
</Base>
