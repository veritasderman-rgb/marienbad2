---
import PillarPage from '../../components/PillarPage.astro'
import { getEntry } from 'astro:content'
const entry = await getEntry('pages', 'ru-obzor-istochnikov')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="ru" title="Обзор источников" eyebrow="Целебные источники" coverTone="water"
  breadcrumbs={[{label:'Главная',href:'/ru/'},{label:'Источники',href:'/ru/mineralnye-istochniki'},{label:'Обзор источников'}]}>
  {Content ? <Content /> : <p>Содержание будет добавлено. Эта страница будет наполнена контентом Ensana.</p>}
</PillarPage>
