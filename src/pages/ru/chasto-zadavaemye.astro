---
import { getEntry } from 'astro:content'
import PillarPage from '../../components/PillarPage.astro'
const entry = await getEntry('pages', 'ru-faq')
const Content = entry ? (await entry.render()).Content : null
---
<PillarPage locale="ru" title="Частые вопросы" eyebrow="FAQ" coverTone="warm"
  breadcrumbs={[{label:'Главная',href:'/ru/'},{label:'Практическое',href:'/ru/prakticheskaya-informaciya'},{label:'Частые вопросы'}]}>
  {Content ? <Content /> : <p>Содержание будет добавлено. Эта страница будет наполнена контентом Ensana.</p>}
</PillarPage>
