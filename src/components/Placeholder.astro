---
interface Props {
  label?: string
  tone?: 'colonnade' | 'water' | 'mineral' | 'forest' | 'warm' | 'default'
  class?: string
  style?: string
}
const { label, tone = 'default', class: cls, style } = Astro.props
---
<div
  class:list={['placeholder-gradient', 'w-full', 'h-full', cls]}
  data-tone={tone}
  style={style}
  aria-hidden="true"
>
  {label && (
    <span style="position:absolute;bottom:12px;left:12px;right:12px;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--ensana-indigo-80);opacity:0.7;pointer-events:none;">
      {label}
    </span>
  )}
</div>
