---
import { getCollection } from 'astro:content'
import type { Locale } from '../i18n/config'
import { routes } from '../i18n/config'
import { t } from '../i18n/ui'
import Placeholder from './Placeholder.astro'

interface Props { locale: Locale; accentColour?: 'turquoise' | 'yellow' }
const { locale, accentColour = 'turquoise' } = Astro.props
const accent = accentColour === 'yellow' ? '#E4C158' : '#8BD3E6'

const allStories = await getCollection('stories', (e) => e.data.status !== 'draft')
const localized = allStories.filter((s) => s.data.locale === locale)
const picks = (localized.length >= 3 ? localized : allStories).slice(0, 3)

const peopleSlug = (routes['people'] as any)[locale] ?? 'menschen'
const magazineHref = `/${locale}/${peopleSlug}`

const tones: Array<'water' | 'mineral' | 'warm'> = ['water', 'mineral', 'warm']
---
<section style="padding:110px 80px;background:#0F3B52;color:#fff;">
  <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:56px;">
    <div style="max-width:640px;">
      <div style={`font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:${accent};font-weight:700;`}>
        {t(locale, 'home.stories.eyebrow')}
      </div>
      <h2 style="font-size:clamp(36px,5vw,56px);font-weight:700;line-height:1.02;letter-spacing:-0.012em;margin:18px 0 0;">
        {t(locale, 'home.stories.title')}
      </h2>
    </div>
    <a href={magazineHref} style="color:rgba(255,255,255,0.85);font-size:14px;font-weight:600;text-decoration:underline;text-underline-offset:4px;white-space:nowrap;">
      {t(locale, 'home.stories.all')}
    </a>
  </div>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;">
    {picks.map((story, i) => {
      const slug = story.slug.replace(/^[a-z]{2}-/, '')
      const name = story.data.name ?? story.data.personName ?? story.data.title
      const href = `/${locale}/${peopleSlug}/${slug}`
      return (
        <a href={href} style="display:flex;flex-direction:column;color:inherit;text-decoration:none;">
          <div style="height:260px;border-radius:8px;overflow:hidden;margin-bottom:20px;position:relative;background:#1d4a62;">
            <Placeholder src={story.data.portrait} alt={name} label={name} tone={tones[i % 3]} />
          </div>
          {story.data.location && (
            <div style={`font-size:11px;letter-spacing:0.18em;text-transform:uppercase;font-weight:700;color:${accent};`}>{story.data.location}</div>
          )}
          <h3 style="font-size:24px;font-weight:700;margin:10px 0;line-height:1.2;">{name}</h3>
          {story.data.quote && (
            <p style="font-size:15px;font-weight:400;line-height:1.55;color:rgba(255,255,255,0.78);margin:0;font-style:italic;">&ldquo;{story.data.quote.slice(0, 140)}{story.data.quote.length > 140 ? '…' : ''}&rdquo;</p>
          )}
          {story.data.visitLabel && (
            <div style="margin-top:16px;font-size:12px;color:rgba(255,255,255,0.6);font-weight:600;letter-spacing:0.08em;">{story.data.visitLabel}</div>
          )}
        </a>
      )
    })}
  </div>
</section>
