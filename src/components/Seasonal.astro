---
import type { Locale } from '../i18n/config'
import { t } from '../i18n/ui'
import Placeholder from './Placeholder.astro'

interface Props { locale: Locale; accentColour?: 'turquoise' | 'yellow' }
const { locale, accentColour = 'turquoise' } = Astro.props
const accentMuted = accentColour === 'yellow' ? '#A4642F' : '#33728D'
---
<section style="padding:110px 80px;background:#fff;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;">
    <div style="position:relative;aspect-ratio:4/5;border-radius:8px;overflow:hidden;">
      <Placeholder label="Spring cure in the park, late April" tone="forest" />
      <div style="position:absolute;left:20px;bottom:20px;color:#fff;">
        <div style="font-size:11px;letter-spacing:0.18em;font-weight:600;text-transform:uppercase;opacity:0.9;">
          {t(locale, 'home.seasonal.now')}
        </div>
        <div style="font-size:28px;font-weight:700;margin-top:8px;line-height:1.1;">
          {t(locale, 'home.seasonal.season')}
        </div>
      </div>
    </div>
    <div>
      <div style={`font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:${accentMuted};font-weight:700;`}>
        {t(locale, 'home.seasonal.eyebrow')}
      </div>
      <h2 style="font-size:clamp(32px,4vw,52px);font-weight:700;color:#004F71;line-height:1.02;letter-spacing:-0.012em;margin:18px 0 0;">
        {t(locale, 'home.seasonal.title')}
      </h2>
      <p style="font-size:17px;font-weight:350;color:#33728D;line-height:1.6;margin-top:24px;">
        {t(locale, 'home.seasonal.body')}
      </p>
      <div style="display:flex;gap:12px;margin-top:32px;flex-wrap:wrap;">
        <a href="https://www.ensanahotels.com" target="_blank" rel="noopener" class="btn btn-primary">
          {t(locale, 'home.seasonal.cta1')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round"/></svg>
        </a>
        <a href="#sources" class="btn btn-ghost">{t(locale, 'home.seasonal.cta2')}</a>
      </div>
    </div>
  </div>
</section>
